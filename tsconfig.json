{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@uaap/core": ["packages/core/src/index.ts"],
      "@uaap/core/*": ["packages/core/src/*"],
      "@uaap/authorization-kernel": ["packages/authorization-kernel/src/index.ts"],
      "@uaap/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@uaap/audit": ["packages/audit/src/index.ts"],
      "@uaap/tool-broker": ["packages/tool-broker/src/index.ts"],
      "@uaap/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@uaap/agent-events": ["packages/agent-events/src/index.ts"],
      "@uaap/agent-permissions": ["packages/agent-permissions/src/index.ts"],
      "@uaap/tool-adapter-registry": ["packages/tool-adapter-registry/src/index.ts"],
      "@uaap/project-model": ["packages/project-model/src/index.ts"],
      "@uaap/digital-twin": ["packages/digital-twin/src/index.ts"],
      "@uaap/evidence-engine": ["packages/evidence-engine/src/index.ts"],
      "@uaap/verification-engine": ["packages/verification-engine/src/index.ts"],
      "@uaap/release-gate": ["packages/release-gate/src/index.ts"],
      "@uaap/remediation-engine": ["packages/remediation-engine/src/index.ts"],
      "@uaap/knowledge": ["packages/knowledge/src/index.ts"],
      "@uaap/agent-evaluation": ["packages/agent-evaluation/src/index.ts"],
      "@uaap/domain-model": ["packages/domain-model/src/index.ts"],
      "@uaap/assurance-planner": ["packages/assurance-planner/src/index.ts"],
      "@uaap/knowledge-graph": ["packages/knowledge-graph/src/index.ts"],
      "@uaap/engine-core": ["packages/engine-core/src/index.ts"],
      "@uaap/quality-api-engine": ["packages/quality-api-engine/src/index.ts"],
      "@uaap/quality-database-engine": ["packages/quality-database-engine/src/index.ts"],
      "@uaap/quality-realtime-engine": ["packages/quality-realtime-engine/src/index.ts"],
      "@uaap/quality-performance-engine": ["packages/quality-performance-engine/src/index.ts"],
      "@uaap/quality-accessibility-engine": ["packages/quality-accessibility-engine/src/index.ts"],
      "@uaap/security-appsec-engine": ["packages/security-appsec-engine/src/index.ts"],
      "@uaap/research-intelligence": ["packages/research-intelligence/src/index.ts"],
      "@uaap/desktop-viewmodels": ["packages/desktop-viewmodels/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "**/dist/**", "apps/desktop/renderer/**"]
}

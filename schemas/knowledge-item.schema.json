{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaap.local/schemas/knowledge-item.schema.json",
  "title": "UAAP Knowledge Item",
  "description": "A single knowledge item with provenance and lifecycle. External information is never ACTIVE without passing the lifecycle; SELF-LEARNING != SELF-TRUSTING.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledgeId", "title", "category", "source", "sourceType",
    "trustTier", "scope", "lifecycleStatus", "retrievedAt"
  ],
  "properties": {
    "knowledgeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "technology": { "type": "string" },
    "version": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "sourceType": { "type": "string" },
    "sourceReference": { "type": "string" },
    "publisher": { "type": "string" },
    "retrievedAt": { "type": "string" },
    "publishedAt": { "type": "string" },
    "contentHash": { "type": "string" },
    "license": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "trustTier": { "enum": ["TIER_0", "TIER_1", "TIER_2", "TIER_3", "TIER_4"] },
    "scope": { "enum": ["GLOBAL", "ORGANIZATION", "PROJECT", "RUN"] },
    "scopeRef": { "type": "string", "description": "Owning id for non-GLOBAL scopes (organizationId / projectId / runId)." },
    "lifecycleStatus": {
      "enum": [
        "DISCOVERED", "CANDIDATE", "SOURCE_VERIFIED", "SANDBOXED", "EVALUATED",
        "REVIEWED", "CERTIFIED", "ACTIVE", "STALE", "DEPRECATED", "REVOKED", "SUPERSEDED"
      ]
    },
    "reviewStatus": { "type": "string" },
    "evaluationStatus": { "type": "string" },
    "certificationStatus": { "type": "string" },
    "validFrom": { "type": "string" },
    "lastVerified": { "type": "string" },
    "stalenessPolicy": { "type": "string" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "supersededBy": { "type": "string" }
  }
}

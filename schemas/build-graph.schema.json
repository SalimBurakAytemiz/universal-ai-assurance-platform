{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaap.local/schemas/build-graph.schema.json",
  "title": "UAAP Build Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "nodes"],
  "properties": {
    "version": { "type": "string" },
    "updatedAt": { "type": "string" },
    "model": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "family", "dependencies", "status", "requirements"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "status": {
            "enum": ["NOT_STARTED", "READY", "RUNNING", "BLOCKED", "VALIDATING", "REVIEWING", "DONE"]
          },
          "requirements": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } },
          "commits": { "type": "array", "items": { "type": "string" } },
          "review": { "type": "object" }
        }
      }
    }
  }
}

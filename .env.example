# Universal AI Assurance Platform — environment variable NAMES only.
# Never commit real secret VALUES. The Tool Broker injects real values at runtime
# from the OS secret store / vault; packages receive secret REFERENCES, not values.

# AI providers (references resolved by the model-router adapter; optional for core build)
UAAP_ANTHROPIC_API_KEY=
UAAP_OPENAI_API_KEY=
UAAP_GOOGLE_API_KEY=

# GitHub automation (gh CLI token is used if these are unset)
UAAP_GITHUB_TOKEN=

# dependencies
node_modules/
.pnp.*
# build output
dist/
build/
out/
*.tsbuildinfo
apps/desktop/release/
# logs
*.log
npm-debug.log*
# runtime evidence/reports (keep dirs via .gitkeep, ignore contents)
evidence/*
!evidence/.gitkeep
reports/*
!reports/.gitkeep
# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
# test artifacts
coverage/
playwright-report/
test-results/

# autopilot runtime artifacts (machine-local durable state)
.ai/autopilot/jobs.json
.ai/autopilot/jobs.json.bak
.ai/autopilot/control.json
.ai/autopilot/jobs.lock
.ai/autopilot/jobs.json.corrupt
.ai/autopilot/monitor.json
.ai/autopilot/provider.json
.ai/autopilot/*.pid
.ai/autopilot/*.tmp
.ai/autopilot/*.acq.*
.ai/autopilot/*.steal.*
apps/desktop/vendor/
apps/desktop/dist/

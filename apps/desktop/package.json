{
  "name": "@uaap/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Universal AI Assurance Platform — desktop control plane (Electron shell).",
  "main": "src/main.js",
  "scripts": {
    "bundle": "node scripts/build-viewmodels.mjs",
    "predev": "npm run bundle",
    "dev": "electron .",
    "smoke": "electron smoke/headless-smoke.cjs",
    "previews": "npm run bundle",
    "views": "electron smoke/views-smoke.cjs",
    "prepackage:dir": "npm run bundle",
    "package:dir": "electron-packager . UAAP --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"/dist($|/)\" --ignore=\"/scripts($|/)\"",
    "verify:package": "node scripts/verify-package.mjs",
    "build": "npm run package:dir"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^32.1.2",
    "esbuild": "^0.21.5"
  }
}
